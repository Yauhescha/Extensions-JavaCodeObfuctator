{
  "manifest_version": 3,
  "name": "Java Code Privacy Helper",
  "description": "Reversible Java identifier obfuscation before sending code snippets to AI chats. Runs locally in the browser.",
  "version": "1.3.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Java Code Privacy Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "options_page": "options.html"
}
